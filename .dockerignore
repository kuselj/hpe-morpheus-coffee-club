# Build outputs and local state must never be copied into the image.
target/
build/
.gradle/
data/

# npm workspaces hoist to the repository root, so both locations are excluded.
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# The lockfile records native binaries only for the platform that generated it, so the container
# must resolve its own. See the comment above the npm install in the Dockerfile.
package-lock.json

.git/
.github/
.idea/
.vscode/
.claude/

*.md
!README.md

Dockerfile
.dockerignore
